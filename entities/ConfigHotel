{
    "name": "ConfigHotel",
    "type": "object",
    "properties": {
        "nombre_hotel": {
            "type": "string"
        },
        "ruc": {
            "type": "string"
        },
        "direccion": {
            "type": "string"
        },
        "telefono": {
            "type": "string"
        },
        "email": {
            "type": "string"
        },
        "ciudad": {
            "type": "string"
        },
        "modo_sunat": {
            "type": "string",
            "enum": [
                "manual",
                "automatico",
                "desactivado"
            ],
            "default": "manual"
        },
        "logo_url": {
            "type": "string"
        },
        "mensaje_ticket": {
            "type": "string",
            "default": "\u00a1Gracias por su preferencia!"
        },
        "hora_checkin": {
            "type": "string",
            "default": "14:00"
        },
        "hora_checkout": {
            "type": "string",
            "default": "12:00"
        }
    },
    "required": [
        "nombre_hotel"
    ]
}