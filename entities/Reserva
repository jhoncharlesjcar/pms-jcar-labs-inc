{
    "name": "Reserva",
    "type": "object",
    "properties": {
        "numero_reserva": {
            "type": "string",
            "description": "C\u00f3digo \u00fanico de reserva"
        },
        "habitacion_id": {
            "type": "string"
        },
        "habitacion_numero": {
            "type": "string"
        },
        "habitacion_tipo": {
            "type": "string"
        },
        "huesped_nombre": {
            "type": "string"
        },
        "huesped_dni": {
            "type": "string"
        },
        "huesped_telefono": {
            "type": "string"
        },
        "huesped_procedencia": {
            "type": "string"
        },
        "fecha_entrada": {
            "type": "string",
            "format": "date"
        },
        "fecha_salida": {
            "type": "string",
            "format": "date"
        },
        "noches": {
            "type": "number"
        },
        "precio_noche": {
            "type": "number"
        },
        "total": {
            "type": "number"
        },
        "estado": {
            "type": "string",
            "enum": [
                "pendiente",
                "activa",
                "finalizada",
                "cancelada"
            ],
            "default": "pendiente"
        },
        "observaciones": {
            "type": "string"
        },
        "num_adultos": {
            "type": "number",
            "default": 1
        },
        "num_ninos": {
            "type": "number",
            "default": 0
        }
    },
    "required": [
        "habitacion_id",
        "huesped_nombre",
        "fecha_entrada",
        "fecha_salida"
    ],
    "rls": {
        "create": {
            "data.hotel_id": "{{user.hotel_id}}",
            "user_condition": {
                "hotel_id": {
                    "$exists": true
                }
            }
        },
        "read": {
            "data.hotel_id": "{{user.hotel_id}}",
            "user_condition": {
                "hotel_id": {
                    "$exists": true
                }
            }
        },
        "update": {
            "data.hotel_id": "{{user.hotel_id}}",
            "user_condition": {
                "hotel_id": {
                    "$exists": true
                }
            }
        },
        "delete": {
            "data.hotel_id": "{{user.hotel_id}}",
            "user_condition": {
                "hotel_id": {
                    "$exists": true
                }
            }
        }
    }
}