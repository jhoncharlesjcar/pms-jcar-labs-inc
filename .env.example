# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
VITE_ENVIRONMENT=development
VITE_RELEASE=local

# Edge Function secrets are configured with `supabase secrets set`; never prefix them with VITE_:
# CHANNEL_CREDENTIAL_MASTER_KEY=<base64url-encoded-32-random-bytes>
# PUBLIC_APP_URL=https://pms.example.com
# CRON_SECRET=<random-secret-for-scheduled-jobs>
# AI_PROVIDER=qwen  (qwen | gemini; por defecto qwen)
# QWEN_API_KEY=<dashscope-api-key>
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# GEMINI_API_KEY=<server-only-key>  (alternativa si AI_PROVIDER=gemini)
# GEMINI_MODEL=gemini-2.0-flash
# TURNSTILE_SECRET_KEY=<server-only-cloudflare-turnstile-secret>
