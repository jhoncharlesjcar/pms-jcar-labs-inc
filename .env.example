# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Function secrets are configured with `supabase secrets set`; never prefix them with VITE_:
# AI_SESSION_SECRET=<at-least-32-random-characters>
# CHANNEL_GATEWAY_SECRET=<at-least-32-random-characters>
# CRON_SECRET=<random-secret-for-scheduled-jobs>
# GEMINI_API_KEY=<server-only-key>
