# SUNAT Wrapper Configuration
# ============================

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# SUNAT Environment (beta | production)
SUNAT_ENV=beta

# SUNAT Endpoints
# Beta/SQA: https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# Production: https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PRODUCTION_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# SUNAT Credentials (RUC + Usuario SOL + Clave SOL)
# Username = RUC + USUARIO_SOL (ej: 20100066603MODDATOS)
SUNAT_RUC=20000000001
SUNAT_USUARIO_SOL=MODDATOS
SUNAT_CLAVE_SOL=your_clave_sol_here

# Digital Certificate
# Option 1: PFX file (base64 encoded)
SUNAT_PFX_BASE64=
SUNAT_PFX_PASSWORD=

# Option 2: PEM files (private key + certificate)
SUNAT_PRIVATE_KEY_PEM=
SUNAT_CERTIFICATE_PEM=

# ZIP/XML Encoding
XML_ENCODING=UTF-8
ZIP_COMMENT=Generated by SUNAT Wrapper v1.0.0

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Timeout for SUNAT SOAP calls (ms)
SUNAT_TIMEOUT_MS=30000