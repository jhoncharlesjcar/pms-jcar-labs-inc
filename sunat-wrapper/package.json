{
  "name": "sunat-wrapper",
  "version": "1.0.0",
  "description": "Microservicio wrapper para integración con WebServices SOAP de SUNAT (Perú) - UBL 2.0, XMLDSig, WS-Security",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "sunat",
    "ubl2.0",
    "xml-dsig",
    "soap",
    "ws-security",
    "peru",
    "facturacion-electronica"
  ],
  "author": "JCAR Labs",
  "license": "MIT",
  "dependencies": {
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^1.1.9",
    "jszip": "^3.10.1",
    "node-forge": "^1.3.1",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/xml2js": "^0.4.14",
    "pino-pretty": "^11.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}