{
        "name": "pms-jcar-labs",
        "private": true,
        "version": "3.0.0",
        "type": "module",
        "packageManager": "pnpm@9.15.9",
        "engines": {
                "node": ">=22",
                "pnpm": ">=9"
        },
        "scripts": {
                "dev": "vite",
                "build": "vite build",
                "lint": "eslint src --max-warnings=0",
                "lint:fix": "eslint . --fix",
                "typecheck": "tsc --noEmit",
                "typecheck:js": "tsc -p tsconfig.jscheck.json",
                "test": "vitest run",
                "test:watch": "vitest",
                "test:coverage": "vitest run --coverage",
                "test:e2e": "node scripts/run-e2e.mjs",
                "test:e2e:install": "playwright install --with-deps chromium",
                "check:edge": "node scripts/check-edge.mjs",
                "check:edge:update-lock": "node scripts/check-edge.mjs --update-lock",
                "check:migrations": "node scripts/check-migrations.mjs",
                "check:secrets": "node scripts/check-secrets.mjs",
                "check:ts-suppressions": "node scripts/check-ts-suppressions.mjs",
                "quality": "pnpm lint && pnpm typecheck && pnpm typecheck:js && pnpm check:ts-suppressions && pnpm test:coverage && pnpm check:edge && pnpm check:migrations && pnpm check:secrets && pnpm build",
                "preview": "vite preview"
        },
        "dependencies": {
                "@gsap/react": "^2.1.2",
                "@radix-ui/react-alert-dialog": "^1.1.6",
                "@radix-ui/react-dialog": "^1.1.6",
