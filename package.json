                        "@babel/plugin-transform-modules-systemjs": "7.29.4",
                        "@remix-run/router": "1.23.3",
                        "brace-expansion@<2": "1.1.18",
                        "brace-expansion@>=2 <3": "2.1.4",
                        "brace-expansion@>=3 <5.0.9": "5.0.9",
                        "dompurify": "3.4.13",
                        "fast-uri": "3.1.5",
                        "js-yaml@<4": "3.15.1",
                        "js-yaml@>=4": "4.3.1",
                        "nanoid@<4": "3.3.18",
                        "postcss": "8.5.23",
